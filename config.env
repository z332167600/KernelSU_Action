CONFIG_ENV=config.env

# ===== 内核信息（来自文档 Usage 章节）=====
KERNEL_SOURCE=https://github.com/OnePlusOSS/android_kernel_oneplus_sm8350
KERNEL_SOURCE_BRANCH=oneplus/SM8350_R_11.0
KERNEL_CONFIG=vendor/lemonade_user_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

# ===== Clang 配置（根据文档 FAQ 精神：弃用不稳定的 AOSP）=====
# 文档说明：由于 AOSP Clang 经常 404，我们选择不使用它
USE_CUSTOM_CLANG=false
CLANG_BRANCH=
CLANG_VERSION=

# ===== GCC 配置（根据文档 Usage 章节：Enable GCC 64）=====
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=false

# ===== KernelSU（根据文档：非 GKI 必须用 v0.9.5）=====
ENABLE_KERNELSU=true
KERNELSU_TAG=v0.9.5

# ===== 稳定性配置（根据文档说明）=====
DISABLE_LTO=true
DISABLE_CC_WERROR=true
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true

# ===== 其他（根据文档默认值）=====
ENABLE_CCACHE=true
BUILD_BOOT_IMG=false
