# ===== 基础内核信息 =====
KERNEL_SOURCE=https://github.com/OnePlusOSS/android_kernel_oneplus_sm8350
KERNEL_SOURCE_BRANCH=oneplus/SM8350_R_11.0
KERNEL_CONFIG=vendor/lemonade_user_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

# ===== 编译器配置 (关键修正) =====
# 禁用 AOSP Clang，改用 LineageOS 维护的稳定版本，避免 400/404 错误
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/LineageOS/android_prebuilts_clang_kernel_linux-x86/releases/download/20220601/clang-r416183b.tar.gz

# 额外的编译指令，确保使用 LLVM 工具链
EXTRA_CMDS="CLANG_TRIPLE=aarch64-linux-gnu- LD=ld.lld LLVM=1 LLVM_IAS=1"

# 关闭 GCC，一加5.4内核使用 Clang 更稳定
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false

# ===== KernelSU 配置 =====
ENABLE_KERNELSU=true
KERNELSU_TAG=v0.9.5  # 5.4 内核必须使用此版本

# ===== 编译优化与修复 =====
# 5.4 内核建议关闭 LTO，否则极易编译失败或开机卡米
DISABLE_LTO=true
# 关闭 CC Werror，防止警告被视为错误导致编译中断
DISABLE_CC_WERROR=true

# 自动注入 Kprobes 和 OverlayFS 支持（KernelSU 依赖）
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true

# 非GKI内核通常需要手动 Hook，此处保持 false 使用 v0.9.5 的默认逻辑
APPLY_KSU_PATCH=false

# ===== 构建与输出 =====
# 清理无用包以节省空间
REMOVE_UNUSED_PACKAGES=true
# 启用缓存加速二次编译
ENABLE_CCACHE=true

# 一加9非GKI设备，不直接构建 boot.img，而是生成 AnyKernel3 包
BUILD_BOOT_IMG=false
